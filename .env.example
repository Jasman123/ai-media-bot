# --- Telegram
BOT_TOKEN=123456:ABC-your-token
BOT_USERNAME=your_bot_username
WEBHOOK_URL=https://bot.example.com
WEBHOOK_SECRET=some_random_string_A-Za-z0-9_-
# Keep false in production (C2): dropping pending updates can lose successful_payment updates.
DROP_PENDING_UPDATES=false

# --- Admin API
API_KEY=another_random_string

# --- Postgres / Redis
DATABASE_URL=postgresql+asyncpg://aimb:aimb@localhost:5432/aimb
REDIS_URL=redis://localhost:6379/0

# --- Logging
LOG_LEVEL=INFO
LOG_JSON=false

# --- Pricing (plan §5): stars = ceil(provider_cost_usd × MARKUP ÷ STARS_NET_USD)
STARS_NET_USD=0.013
MARKUP=3
MIN_MARGIN=1.5

# --- Providers
# Zero-spend FakeProvider for development/CI. MUST be false in production.
ENABLE_FAKE_PROVIDER=true
